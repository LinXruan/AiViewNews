# Copy to .env and fill in. The admin settings page (PLAN 12) overrides these.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# First-run administrator. Leave ADMIN_PASSWORD empty to create it at /setup
# (localhost only, only while the users table is empty).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Demo user is created only when this password is set.
DEMO_PASSWORD=

# Session signing secret. Generated into <DATA_DIR>/secret.key when empty.
SESSION_SECRET=

# Optional writable data directory (database, uploads, parsed text, logs).
DATA_DIR=

# mineru executable, installed in its own Python 3.13 environment.
MINERU_CMD=
